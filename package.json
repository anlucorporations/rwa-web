{
  "name": "rwa-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:identity": "pnpm --filter @rwa/identity dev -- -p 4001",
    "dev:issuer": "pnpm --filter @rwa/issuer dev -- -p 4002",
    "dev:token": "pnpm --filter @rwa/token dev -- -p 4003",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "sync:contracts": "bash scripts/sync-contracts.sh",
    "check:contract-drift": "bash scripts/check-contract-drift.sh",
    "check:network-literals": "bash scripts/check-network-literals.sh",
    "check:media": "pnpm --filter @rwa/shared check:media",
    "smoke:services": "bash scripts/smoke_o0.sh",
    "smoke:app": "bash scripts/smoke_app_o0.sh",
    "test:auth": "bash scripts/test_auth_o1.sh",
    "test:review": "bash scripts/test_review_o1.sh",
    "ci": "bash scripts/ci_local.sh",
    "a11y:o5": "node scripts/a11y_o5.mjs",
    "perf:o5": "node scripts/perf_budget_o5.mjs",
    "test:coverage": "pnpm --filter @rwa/shared test",
    "db:backup": "node scripts/backup_o5.mjs",
    "db:retention": "node scripts/retention_o5.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "pg": "^8.13.0"
  }
}
