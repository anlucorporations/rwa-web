# =============================================================================
# RWA web — variables de entorno (PLANTILLA, sin secretos)
# Copiar a `.env.local` (ignorado por git) y rellenar los secretos.
# Los valores de red y BD son los servicios REALES de GCP (verificados 2026-10-14).
# =============================================================================

# --- Red on-chain: Anvil de GCP (chain 31337) — D-096 -------------------------
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=https://mcc-foundry-anvil-1095249147821.europe-west1.run.app
NEXT_PUBLIC_DEPLOYMENT_JSON=rwa-sc/sc/deployments/31337-20261023T185622Z.json

# --- BD off-chain: PostgreSQL en GCP (Cloud SQL truekeate-db-dev) — D-095/D-097
# Forma canónica (Cloud Run o Auth Proxy: socket unix):
#   DATABASE_URL=postgresql://app:<PASSWORD>@/truekeate?host=/cloudsql/truekeate-main:southamerica-east1:truekeate-db-dev
# Forma local desde un host autorizado en el ACL (TCP a la IP pública):
#   DATABASE_URL=postgresql://app:<PASSWORD>@34.39.180.101:5432/truekeate?sslmode=disable
# Recomendado: NO escribirla aquí; usar `source rwa-web/scripts/gcp-env.sh --tcp`,
# que la obtiene de Secret Manager en tiempo de ejecución sin persistirla.
DATABASE_URL=

# --- Secretos de aplicación (Secret Manager; NUNCA en el repositorio) --------
# SIWE_SESSION_SECRET: firma HMAC de la cookie de sesión (D-092). OBLIGATORIA y de
#   al menos 32 caracteres; sin ella las rutas protegidas fallan en cerrado.
#   Producción: Secret Manager (el nombre NO existe aún en `truekeate-main`; hay que crearlo).
#   Desarrollo: `.env.local` en CADA app (gitignored), p. ej. `openssl rand -hex 32`.
SIWE_SESSION_SECRET=
KYC_ENCRYPTION_KEY=

# --- Operación ---------------------------------------------------------------
LOG_LEVEL=info
ALLOW_DEBUG_ENDPOINTS=0
