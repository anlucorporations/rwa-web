# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.indexer — imagen del indexer off-chain (H-12/H-21) para Cloud Run Jobs
#
# El indexer es un CLI Node (no Next): se ejecuta con `tsx` sobre el monorepo.
# Uso local:
#   docker build -f Dockerfile.indexer -t rwa/indexer .
#   docker run --rm -e DATABASE_URL=... -e RPC_URL=... rwa/indexer --once
#
# En Cloud Run Jobs el comando por defecto procesa una pasada (`--once`) y
# termina; la ejecución periódica la programa Cloud Scheduler.
# =============================================================================

FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /repo

# Dependencias: se instala el monorepo completo (workspace:*) con devDependencies
# porque `tsx` es devDependency del paquete @rwa/indexer.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /repo

# `--once` por defecto: en Cloud Run Jobs cada ejecución debe terminar.
ENTRYPOINT ["pnpm", "--filter", "@rwa/indexer", "exec", "tsx", "src/main.ts"]
CMD ["--once"]
