# =============================================================================
# Plantilla de entorno de esta app (sin secretos). Copiar a `.env.local` (ignorado).
# Referencia completa y valores de los servicios de GCP: ../.env.example
# =============================================================================

# Red on-chain canónica (Anvil de GCP, chain 31337) — D-096
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=

# Firma de la cookie de sesión SIWE (mínimo 32 caracteres; Secret Manager en producción)
SIWE_SESSION_SECRET=

# Operación
LOG_LEVEL=info
ALLOW_DEBUG_ENDPOINTS=0
