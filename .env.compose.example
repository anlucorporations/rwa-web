# =============================================================================
# Variables para `docker compose` (O5.1). Copiar a `.env.compose` (ignorado) y
# rellenar los secretos. NO versionar valores reales.
# =============================================================================

# --- PostgreSQL del compose (servicio `db`) ----------------------------------
POSTGRES_DB=truekeate
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia-esta-clave
DATABASE_URL=postgresql://app:cambia-esta-clave@db:5432/truekeate?sslmode=disable

# --- Red on-chain (se inlinea en el bundle: build args) ----------------------
# Por defecto, el Anvil de GCP documentado en .env.example.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=https://mcc-foundry-anvil-1095249147821.europe-west1.run.app
NEXT_PUBLIC_DEPLOYMENT_JSON=rwa-sc/sc/deployments/31337-20261010T162639Z.json

# --- Secretos de aplicación (obligatorios) -----------------------------------
# openssl rand -hex 32
SIWE_SESSION_SECRET=
KYC_ENCRYPTION_KEY=

# --- Operación ---------------------------------------------------------------
LOG_LEVEL=info
ALLOW_DEBUG_ENDPOINTS=0
